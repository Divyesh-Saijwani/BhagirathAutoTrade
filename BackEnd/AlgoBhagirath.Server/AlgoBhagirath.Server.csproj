    <ProjectReference Include="..\Infrastructure\Persistance\Persistance.csproj" />
    <ProjectReference Include="..\Infrastructure\Presentation\Presentation.csproj" />
    <ProjectReference Include="..\Operations\MarketCore\IciciDirectBreeze\IciciDirectBreeze.csproj" />
  </ItemGroup>

</Project>
